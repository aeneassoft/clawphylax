{
  "name": "clawphylax",
  "version": "0.5.1",
  "description": "Did that actually work? Did my message actually go out? Is this safe to send? Why did my request fail? Should I stop and ask? Am I going in circles? What did I lose in compaction? 22 answers for OpenClaw agents from a local ledger of every request and tool outcome. Verify skills before install; see where installed skills send data; catch silent failures (tool said ok, wire said 403); confirm message delivery against the channel API; keep secrets from leaving. No cloud, no telemetry, observe-only by default, MIT.",
  "type": "module",
  "license": "MIT",
  "author": "Leonhard Hampe",
  "homepage": "https://github.com/aeneassoft/clawphylax#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeneassoft/clawphylax.git"
  },
  "bugs": {
    "url": "https://github.com/aeneassoft/clawphylax/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-skill",
    "ai-agents",
    "agent-security",
    "supply-chain",
    "egress",
    "network-monitor",
    "exfiltration",
    "skill-audit",
    "clawhub",
    "self-diagnostics",
    "silent-failure",
    "message-delivery",
    "verification",
    "secrets",
    "prompt-injection"
  ],
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "plugin:link": "npm run build && openclaw plugins install --link . && openclaw plugins enable clawphylax",
    "plugin:inspect": "openclaw plugins inspect clawphylax --runtime --json",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "openclaw": "2026.6.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.6.1",
      "pluginSdkVersion": "2026.6.1"
    }
  },
  "dependencies": {
    "typebox": "^1.3.34"
  }
}
