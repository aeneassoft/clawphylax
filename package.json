{
  "name": "clawphylax",
  "version": "0.5.0",
  "description": "Skill safety and agent self-diagnostics for OpenClaw: verify skills before install, see where installed skills send data, and let the agent ask itself the troubleshooting questions — will this request work, why do I keep failing, should I stop and ask, am I going in circles, could this get the user banned, what has this cost, which path is worth it. Local ledger, no cloud, observe-only by default.",
  "type": "module",
  "license": "MIT",
  "author": "Leonhard Hampe",
  "homepage": "https://github.com/aeneassoft/clawphylax#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeneassoft/clawphylax.git"
  },
  "bugs": {
    "url": "https://github.com/aeneassoft/clawphylax/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-skill",
    "ai-agents",
    "agent-security",
    "supply-chain",
    "egress",
    "network-monitor",
    "exfiltration",
    "skill-audit"
  ],
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "plugin:link": "npm run build && openclaw plugins install --link . && openclaw plugins enable clawphylax",
    "plugin:inspect": "openclaw plugins inspect clawphylax --runtime --json",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "openclaw": "2026.6.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.6.1",
      "pluginSdkVersion": "2026.6.1"
    }
  },
  "dependencies": {
    "typebox": "^1.3.34"
  }
}
